 */
+/* qcport fixture: QEDDUMP=<file> writes each edict's nonzero fields after its parse (P) and its
+   spawn function (S), and every builtin call during the load (B), for qcport's qvm/ed tests. */
+static FILE	*eddump_f;
+static qboolean	eddump_loading;
+
+/* a text quoted on one line: newline, quote and backslash escaped, other control bytes as \xNN */
+static void EdDump_Text (const char *s)
+{
+	fputc ('"', eddump_f);
+	for (; *s; s++)
+	{
+		if (*s == '\n')
+			fputs ("\\n", eddump_f);
+		else if (*s == '"' || *s == '\\')
+			fprintf (eddump_f, "\\%c", *s);
+		else if ((unsigned char) *s < 32)
+			fprintf (eddump_f, "\\x%02x", (unsigned char) *s);
+		else
+			fputc (*s, eddump_f);
+	}
+	fputc ('"', eddump_f);
+}
+
+/* a def's words as text: vectors and floats as bits, strings as text ("-" for null), entities
+   as edict numbers */
+static void EdDump_Value (int type, const char *name, int *v)
+{
+	switch (type & ~DEF_SAVEGLOBAL)
+	{
+	case ev_vector:
+		fprintf (eddump_f, " v %s %08x %08x %08x\n", name, v[0], v[1], v[2]);
+		break;
+	case ev_string:
+		if (v[0])
+		{
+			fprintf (eddump_f, " s %s ", name);
+			EdDump_Text (PR_GetString (v[0]));
+			fputc ('\n', eddump_f);
+		}
+		else
+			fprintf (eddump_f, " s %s -\n", name);
+		break;
+	case ev_entity:
+		fprintf (eddump_f, " e %s %d\n", name, NUM_FOR_EDICT (PROG_TO_EDICT (v[0])));
+		break;
+	default:
+		fprintf (eddump_f, " %d %s %08x\n", type & ~DEF_SAVEGLOBAL, name, v[0]);
+		break;
+	}
+}
+
+/* words a vector def covers: its _x _y _z float defs are not values of their own. By offset,
+   not name: hit_z is a float field and no vector's component. */
+static byte	*eddump_fcomp, *eddump_gcomp;
+
+static void EdDump_Components (void)
+{
+	int	i;
+
+	eddump_fcomp = (byte *) calloc (progs->entityfields + 3, 1);
+	eddump_gcomp = (byte *) calloc (progs->numglobals + 3, 1);
+	for (i = 0; i < progs->numfielddefs; i++)
+		if ((pr_fielddefs[i].type & ~DEF_SAVEGLOBAL) == ev_vector)
+			memset (eddump_fcomp + pr_fielddefs[i].ofs, 1, 3);
+	for (i = 0; i < progs->numglobaldefs; i++)
+		if ((pr_globaldefs[i].type & ~DEF_SAVEGLOBAL) == ev_vector)
+			memset (eddump_gcomp + pr_globaldefs[i].ofs, 1, 3);
+}
+
+static qboolean EdDump_Component (ddef_t *d)
+{
+	byte	*inside = d >= pr_fielddefs && d < pr_fielddefs + progs->numfielddefs ? eddump_fcomp : eddump_gcomp;
+	return (d->type & ~DEF_SAVEGLOBAL) != ev_vector && inside[d->ofs];
+}
+
+static int EdDump_Words (int type)
+{
+	return (type & ~DEF_SAVEGLOBAL) == ev_vector ? 3 : 1;
+}
+
+static void EdDump_Edict (char tag, edict_t *ed)
+{
+	int		i, *v;
+	ddef_t		*d;
+	const char	*name;
+
+	if (!eddump_f)
+		return;
+	fprintf (eddump_f, "%c %d %d\n", tag, NUM_FOR_EDICT(ed), ed->free);
+	for (i = 1; i < progs->numfielddefs; i++)
+	{
+		d = &pr_fielddefs[i];
+		name = PR_GetString (d->s_name);
+		if (EdDump_Component (d))
+			continue;
+		v = (int *)((char *)&ed->v + d->ofs*4);
+		if (v[0] || (EdDump_Words (d->type) == 3 && (v[1] || v[2])))
+			EdDump_Value (d->type, name, v);
+	}
+}
+
+/* what a call changed: every edict and every named global, before against after. Slot 0 is a
+   builtin's, slot 1 a spawn function's, which spans builtin calls. */
+typedef struct
+{
+	byte	*eds;
+	int	*gl;
+	int	num;
+} eddump_snap_t;
+
+static eddump_snap_t	eddump_snap[2];
+
+static void EdDump_Mark (int slot)
+{
+	eddump_snap_t	*s = &eddump_snap[slot];
+
+	if (!eddump_f)
+		return;
+	if (!s->eds)
+	{
+		s->eds = (byte *) malloc (sv.max_edicts * pr_edict_size);
+		s->gl = (int *) malloc (progs->numglobals * 4);
+	}
+	memcpy (s->eds, sv.edicts, sv.num_edicts * pr_edict_size);
+	memcpy (s->gl, pr_globals, progs->numglobals * 4);
+	s->num = sv.num_edicts;
+}
+
+static void EdDump_Diff (char tag, int slot)
+{
+	static int	zero[3];
+	eddump_snap_t	*s = &eddump_snap[slot];
+	int		n, i, *v, *was;
+	ddef_t		*d;
+	edict_t		*now, *old;
+	const char	*name;
+
+	for (n = 0; n < sv.num_edicts; n++)
+	{
+		now = EDICT_NUM(n);
+		old = n < s->num ? (edict_t *)(s->eds + n*pr_edict_size) : NULL;
+		if (!old || old->free != now->free)
+			fprintf (eddump_f, "%c %d free %d\n", tag, n, now->free);
+		for (i = 1; i < progs->numfielddefs; i++)
+		{
+			d = &pr_fielddefs[i];
+			name = PR_GetString (d->s_name);
+			if (EdDump_Component (d))
+				continue;
+			v = (int *)((char *)&now->v + d->ofs*4);
+			was = old ? (int *)((char *)&old->v + d->ofs*4) : zero;
+			if (!memcmp (v, was, EdDump_Words (d->type) * 4))
+				continue;
+			fprintf (eddump_f, "%c %d", tag, n);
+			EdDump_Value (d->type, name, v);
+		}
+	}
+	for (i = 0; i < progs->numglobaldefs; i++)
+	{
+		d = &pr_globaldefs[i];
+		name = PR_GetString (d->s_name);
+		if (d->ofs < RESERVED_OFS || EdDump_Component (d))
+			continue;
+		v = (int *)&pr_globals[d->ofs];
+		if (!memcmp (v, &s->gl[d->ofs], EdDump_Words (d->type) * 4))
+			continue;
+		fprintf (eddump_f, "%c G", tag);
+		EdDump_Value (d->type, name, v);
+	}
+}
+
+void EdDump_BuiltinBegin (void)
+{
+	if (eddump_f && eddump_loading)
+		EdDump_Mark (0);
+}
+
+/* a builtin's parameters from defs.qc: e entity, s string, v vector, f float, F field offset */
+static const char *EdDump_Sig (int num)
+{
+	switch (num)
+	{
+	case 1: case 9: case 12: case 13: case 27: case 41: case 51:	return "v";
+	case 2:		return "ev";
+	case 3:		return "es";
+	case 4:		return "evv";
+	case 8:		return "efsff";
+	case 10: case 11: case 19: case 20: case 23: case 25: case 45: case 46:
+	case 68: case 70: case 75: case 76: case 77:	return "s";
+	case 15: case 31: case 47: case 69: case 78:	return "e";
+	case 16:	return "vvfe";
+	case 18:	return "eFs";
+	case 21: case 24: case 73:	return "es";
+	case 22:	return "vf";
+	case 26: case 36: case 37: case 38: case 43: case 67:	return "f";
+	case 32:	return "ff";
+	case 35:	return "fs";
+	case 44:	return "ef";
+	case 48:	return "vvff";
+	case 52: case 53: case 54: case 55: case 56: case 57:	return "ff";
+	case 58:	return "fs";
+	case 59:	return "fe";
+	case 72:	return "ss";
+	case 74:	return "vsff";
+	default:	return "";
+	}
+}
+
+/* B num r0 r1 r2 [the return as its type: an edict number or a text] : argc and each
+   parameter as it was before the call -- e<edict>, s"text" or s-, v<bits>,<bits>,<bits>, f<bits> */
+void EdDump_Builtin (int num)
+{
+	int		*r = (int *)&pr_globals[OFS_RETURN];
+	int		*p;
+	const char	*sig;
+
+	if (!eddump_f || !eddump_loading)
+		return;
+	fprintf (eddump_f, "B %d %08x %08x %08x", num, r[0], r[1], r[2]);
+	switch (num)
+	{
+	case 14: case 17: case 18: case 22: case 47:	/* spawn checkclient find findradius nextent */
+		fprintf (eddump_f, " %d", NUM_FOR_EDICT (PROG_TO_EDICT (r[0])));
+		break;
+	case 19: case 20: case 26: case 27: case 68: case 75: case 76: case 77:	/* precache_* ftos vtos */
+		fputc (' ', eddump_f);
+		EdDump_Text (PR_GetString (r[0]));
+		break;
+	}
+	fprintf (eddump_f, " : %d", pr_argc);
+	for (sig = EdDump_Sig (num), p = eddump_snap[0].gl + OFS_PARM0; *sig; sig++, p += 3)
+	{
+		switch (*sig)
+		{
+		case 'e':	fprintf (eddump_f, " e%d", NUM_FOR_EDICT (PROG_TO_EDICT (p[0])));	break;
+		case 's':
+			if (p[0])
+			{
+				fputs (" s", eddump_f);
+				EdDump_Text (PR_GetString (p[0]));
+			}
+			else
+				fprintf (eddump_f, " s-");
+			break;
+		case 'v':	fprintf (eddump_f, " v%08x,%08x,%08x", p[0], p[1], p[2]);	break;
+		default:	fprintf (eddump_f, " f%08x", p[0]);	break;
+		}
+	}
+	fprintf (eddump_f, "\n");
+	EdDump_Diff ('W', 0);
+}
+
