diff --git a/Quake/trace.c b/Quake/trace.c
new file mode 100644
index 0000000..6a20cfc
--- /dev/null
+++ b/Quake/trace.c
@@ -0,0 +1,512 @@
+/*
+ * trace.c -- QuakeC execution trace for qcport's VM study (qcport docs/quakec-vm.md).
+ *
+ *   QTRACE_OUT=<prefix>  write <prefix>.bin (events) and <prefix>.txt (summaries)
+ *   QTRACE_DUMP=<file>   during demo playback, one line per server message:
+ *                        time origin[3] angles[3] onground weaponframe activeweapon health
+ *   QTRACE_BOT=<file>    drive the player along such a dump
+ *   QTRACE_WAKE=1        at the first tick with a live player, every monster hunts it
+ *
+ * <prefix>.bin, little-endian, a tag byte and then:
+ *   'T' f32 time, u16 edicts, u16 awake, u16 missiles, u16 thinkers   a server tick begins
+ *   't'                                                              it ends
+ *   'X' u8 kind, u8 depth, u16 fnum, u16 self, u16 class             an execution begins
+ *   'x' u32 statements                                               it ends
+ *   'F' u16 fnum                                                     a QuakeC function is entered
+ *   'R' u16 fnum                                                     a return resumes this function
+ *   'B' u8 number                                                    a builtin is called
+ *   'D' u16 edict                                                    a field access on another edict
+ *   'S'                                                              a string compare (EQ_S, NE_S, NOT_S)
+ *   'W' u16 woken, u16 monsters                                      QTRACE_WAKE ran
+ *   'P' u8 what: 0 teleport, 1 refill, 2 death, 3 weapon not owned   the bot intervened
+ *
+ * The bot steers a real client: view angles from the dump, movement toward where the dump is 0.1 s
+ * ahead, attack while the dump's weapon frame is non-zero, the dump's weapon by impulse. Stuck more
+ * than 128 units off the path for a second, it is teleported; under 70 health it is set to 100.
+ */
+
+#include "quakedef.h"
+
+#define MAX_TRACE_CLASSES  512
+#define MAX_TRACE_FIELDS   1024
+#define MAX_TRACE_FUNCS    8192
+#define MAX_TRACE_DEPTH    64
+#define STUCK_DIST         128.0f
+#define STUCK_SECONDS      1.0f
+#define LOOKAHEAD          0.1f
+
+typedef struct {
+	float	time;
+	vec3_t	org, ang;
+	int	onground, wframe, weapon, health;
+} pathsample_t;
+
+int		trace_kind = TK_OTHER;
+qboolean	trace_on;
+
+static FILE	*bin, *dump;
+static char	txtname[MAX_OSPATH];
+static unsigned	op_hist[256];
+static unsigned	fn_stmts[MAX_TRACE_FUNCS];
+static dfunction_t *fn_base;
+static const char *class_name[MAX_TRACE_CLASSES];
+static int	num_classes;
+static unsigned	field_rw[MAX_TRACE_CLASSES][MAX_TRACE_FIELDS][2];
+static int	depth;
+static int	last_edict = -1;
+static double	last_dump_time = -1;
+
+static pathsample_t *path;
+static int	path_n;
+static float	stuck;
+static float	last_impulse = -10;
+static double	last_tick_time = -1;
+static qboolean	woken, quitting;
+static unsigned	ticks, teleports, refills, deaths, impulse_failures, progs_loads, woken_n, monsters_n;
+static double	first_tick = -1, path_tick0 = -1;
+static int	asked_weapon;
+
+static void put (const void *p, size_t n)
+{
+	fwrite (p, 1, n, bin);
+}
+
+static void put8 (int v)  { byte b = v; put (&b, 1); }
+static void put16 (int v) { unsigned short s = v; put (&s, 2); }
+
+static int class_of (string_t s)
+{
+	const char *name = PR_GetString (s);
+	int i;
+
+	for (i = 0; i < num_classes; i++)
+		if (!strcmp (class_name[i], name))
+			return i;
+	if (num_classes == MAX_TRACE_CLASSES)
+		return MAX_TRACE_CLASSES - 1;
+	class_name[num_classes] = strdup (name);
+	return num_classes++;
+}
+
+static void finish (void)
+{
+	quitting = true;	/* trace_client_frame quits at the end of the frame */
+}
+
+static void load_path (const char *file)
+{
+	FILE *f = fopen (file, "r");
+	int cap = 0;
+	pathsample_t s;
+
+	if (!f)
+		Sys_Error ("QTRACE_BOT: cannot open %s", file);
+	while (fscanf (f, "%f %f %f %f %f %f %f %d %d %d %d", &s.time, &s.org[0], &s.org[1], &s.org[2],
+		       &s.ang[0], &s.ang[1], &s.ang[2], &s.onground, &s.wframe, &s.weapon, &s.health) == 11)
+	{
+		if (path_n == cap)
+		{
+			cap = cap ? cap * 2 : 4096;
+			path = (pathsample_t *) realloc (path, cap * sizeof(*path));
+		}
+		path[path_n++] = s;
+	}
+	fclose (f);
+	if (!path_n)
+		Sys_Error ("QTRACE_BOT: %s has no samples", file);
+}
+
+static const pathsample_t *sample_at (float t)
+{
+	int lo = 0, hi = path_n - 1;
+
+	while (lo < hi)
+	{
+		int mid = (lo + hi) / 2;
+		if (path[mid].time < t)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return &path[lo];
+}
+
+void trace_init (void)
+{
+	const char *out = getenv ("QTRACE_OUT");
+	const char *s;
+
+	setvbuf (stdout, NULL, _IONBF, 0);
+	if (out)
+	{
+		char name[MAX_OSPATH];
+		q_snprintf (name, sizeof(name), "%s.bin", out);
+		q_snprintf (txtname, sizeof(txtname), "%s.txt", out);
+		bin = fopen (name, "wb");
+		if (!bin)
+			Sys_Error ("QTRACE_OUT: cannot write %s", name);
+		setvbuf (bin, NULL, _IOFBF, 1 << 20);
+		trace_on = true;
+	}
+	if ((s = getenv ("QTRACE_DUMP")) != NULL && !(dump = fopen (s, "w")))
+		Sys_Error ("QTRACE_DUMP: cannot write %s", s);
+	if ((s = getenv ("QTRACE_BOT")) != NULL)
+		load_path (s);
+}
+
+void trace_exec_begin (int fnum)
+{
+	int kind = trace_kind;
+	edict_t *self;
+
+	trace_kind = TK_OTHER;
+	if (fnum == pr_global_struct->StartFrame)
+		kind = TK_STARTFRAME;
+	else if (fnum == pr_global_struct->PlayerPreThink)
+		kind = TK_PRETHINK;
+	else if (fnum == pr_global_struct->PlayerPostThink)
+		kind = TK_POSTTHINK;
+	self = PROG_TO_EDICT (pr_global_struct->self);
+	put8 ('X');
+	put8 (kind);
+	put8 (depth);
+	put16 (fnum);
+	put16 (NUM_FOR_EDICT (self));
+	put16 (class_of (self->v.classname));
+	depth++;
+}
+
+void trace_exec_end (int statements)
+{
+	unsigned u = statements;
+
+	depth--;
+	put8 ('x');
+	put (&u, 4);
+}
+
+void trace_enter (int fnum)
+{
+	put8 ('F');
+	put16 (fnum);
+}
+
+void trace_stmt (int op, int fnum)
+{
+	op_hist[op & 255]++;
+	if (op == OP_EQ_S || op == OP_NE_S || op == OP_NOT_S)
+		put8 ('S');
+	if (fnum < MAX_TRACE_FUNCS)
+		fn_stmts[fnum]++;
+}
+
+void trace_return (int fnum)
+{
+	put8 ('R');
+	put16 (fnum);
+}
+
+void trace_progs_loaded (void)
+{
+	fn_base = pr_functions;
+	memset (fn_stmts, 0, sizeof(fn_stmts));
+	progs_loads++;
+}
+
+void trace_builtin (int num)
+{
+	put8 ('B');
+	put8 (num);
+}
+
+void trace_field (edict_t *ed, int ofs, int write)
+{
+	int num = NUM_FOR_EDICT (ed);
+	if (last_edict != num)
+	{
+		last_edict = num;
+		put8 ('D');
+		put16 (num);
+	}
+	if (ofs >= 0 && ofs < MAX_TRACE_FIELDS)
+		field_rw[class_of (ed->v.classname)][ofs][write ? 1 : 0]++;
+}
+
+static void wake_monsters (edict_t *player)
+{
+	int i, f;
+	func_t found = 0;
+
+	for (f = 1; f < progs->numfunctions; f++)
+		if (!strcmp (PR_GetString (pr_functions[f].s_name), "FoundTarget"))
+			found = f;
+	if (!found)
+		Sys_Error ("QTRACE_WAKE: no FoundTarget in progs");
+	for (i = 1; i < sv.num_edicts; i++)
+	{
+		edict_t *ed = EDICT_NUM (i);
+		if (ed->free || ed->v.health <= 0)
+			continue;
+		if (!strncmp (PR_GetString (ed->v.classname), "monster_", 8))
+			monsters_n++;
+		if (!((int) ed->v.flags & FL_MONSTER))
+			continue;
+		woken_n++;
+		ed->v.enemy = EDICT_TO_PROG (player);
+		pr_global_struct->self = EDICT_TO_PROG (ed);
+		pr_global_struct->other = EDICT_TO_PROG (sv.edicts);
+		pr_global_struct->time = sv.time;
+		trace_kind = TK_WAKE;
+		PR_ExecuteProgram (found);
+	}
+	put8 ('W');
+	put16 (woken_n);
+	put16 (monsters_n);
+}
+
+static void bot_server (edict_t *player)
+{
+	const pathsample_t *s = sample_at (sv.time);
+	vec3_t d;
+
+	if (sv.time > path[path_n - 1].time + 0.5)
+	{
+		finish ();
+		return;
+	}
+	static qboolean alive_seen;
+
+	if (!alive_seen)
+	{	/* the first ticks run before PutClientInServer gives the player health */
+		if (player->v.health <= 0)
+			return;
+		alive_seen = true;
+	}
+	if (player->v.health <= 0)
+	{
+		deaths++;
+		if (trace_on) { put8 ('P'); put8 (2); }
+		finish ();
+		return;
+	}
+	VectorSubtract (s->org, player->v.origin, d);
+	stuck = VectorLength (d) > STUCK_DIST ? stuck + host_frametime : 0;
+	if (stuck > STUCK_SECONDS)
+	{
+		VectorCopy (s->org, player->v.origin);
+		VectorCopy (vec3_origin, player->v.velocity);
+		SV_LinkEdict (player, true);	/* the skipped stretch's triggers still fire */
+		stuck = 0;
+		teleports++;
+		if (trace_on) { put8 ('P'); put8 (0); }
+	}
+	if (player->v.health < 70)
+	{
+		player->v.health = 100;
+		refills++;
+		if (trace_on) { put8 ('P'); put8 (1); }
+	}
+}
+
+void trace_tick_begin (void)
+{
+	edict_t *player = svs.maxclients >= 1 && svs.clients[0].active ? EDICT_NUM (1) : NULL;
+	unsigned short awake = 0, missiles = 0, thinkers = 0;
+	float t = sv.time;
+	int i;
+
+	if (sv.time < last_tick_time)
+	{	/* the level restarted or changed: the path no longer applies */
+		finish ();
+		return;
+	}
+	last_tick_time = sv.time;
+	if (player && path)
+		bot_server (player);
+	if (!trace_on)
+		return;
+	for (i = 1; i < sv.num_edicts; i++)
+	{
+		edict_t *ed = EDICT_NUM (i);
+		if (ed->free)
+			continue;
+		if (((int) ed->v.flags & FL_MONSTER) && ed->v.health > 0 && ed->v.enemy)
+			awake++;
+		if (ed->v.movetype == MOVETYPE_FLYMISSILE || ed->v.movetype == MOVETYPE_BOUNCE)
+			missiles++;
+		if (ed->v.nextthink > 0)
+			thinkers++;
+	}
+	ticks++;
+	if (first_tick < 0)
+		first_tick = sv.time;
+	if (player && path && path_tick0 < 0)
+		path_tick0 = sv.time;
+	put8 ('T');
+	put (&t, 4);
+	put16 (sv.num_edicts);
+	put16 (awake);
+	put16 (missiles);
+	put16 (thinkers);
+	if (player && player->v.health > 0 && !woken && getenv ("QTRACE_WAKE") && sv.time >= first_tick + 1.5)
+	{
+		woken = true;
+		wake_monsters (player);
+	}
+}
+
+void trace_tick_end (void)
+{
+	if (trace_on)
+		put8 ('t');
+}
+
+void trace_client_frame (void)
+{
+	entity_t *e;
+
+	extern double realtime;
+	static double last_beat;
+
+	if (quitting)
+	{	/* Host_Quit_f would open the "are you sure" menu from the game */
+		CL_Disconnect ();
+		Host_ShutdownServer (false);
+		Sys_Quit ();
+	}
+	/* before signon completes too: SV_Physics is skipped while the console is up */
+	if (path && sv.active)
+		key_dest = key_game;
+	if (getenv ("QTRACE_BEAT") && realtime - last_beat >= 1.0)
+	{
+		last_beat = realtime;
+		fprintf (stderr, "beat real %.1f key_dest %d state %d signon %d active %d paused %d sv.time %.2f ticks %u quitting %d\n",
+			 realtime, (int) key_dest, (int) cls.state, cls.signon, (int) sv.active, (int) sv.paused, sv.time, ticks, (int) quitting);
+	}
+	if (!dump || !cls.demoplayback || cls.signon != SIGNONS || cl.mtime[0] == last_dump_time)
+		return;
+	last_dump_time = cl.mtime[0];
+	e = &cl_entities[cl.viewentity];
+	fprintf (dump, "%.4f %.2f %.2f %.2f %.2f %.2f %.2f %d %d %d %d\n", cl.mtime[0],
+		 e->msg_origins[0][0], e->msg_origins[0][1], e->msg_origins[0][2],
+		 cl.mviewangles[0][0], cl.mviewangles[0][1], cl.mviewangles[0][2],
+		 cl.onground ? 1 : 0, cl.stats[STAT_WEAPONFRAME], cl.stats[STAT_ACTIVEWEAPON], cl.stats[STAT_HEALTH]);
+}
+
+void trace_demo_end (void)
+{
+	if (!dump)
+		return;
+	fclose (dump);
+	dump = NULL;
+	finish ();
+}
+
+static int weapon_impulse (int it)
+{
+	switch (it)
+	{
+	case IT_AXE:			return 1;
+	case IT_SHOTGUN:		return 2;
+	case IT_SUPER_SHOTGUN:		return 3;
+	case IT_NAILGUN:		return 4;
+	case IT_SUPER_NAILGUN:		return 5;
+	case IT_GRENADE_LAUNCHER:	return 6;
+	case IT_ROCKET_LAUNCHER:	return 7;
+	case IT_LIGHTNING:		return 8;
+	}
+	return 0;
+}
+
+void trace_bot_move (usercmd_t *cmd)
+{
+	extern kbutton_t in_attack, in_jump;
+	extern int in_impulse;
+	const pathsample_t *now, *ahead;
+	edict_t *player;
+	vec3_t vel;
+	float yaw, len;
+
+	if (!path || !sv.active || !svs.clients[0].active)
+		return;
+	if (!quitting)
+		key_dest = key_game;	/* single player pauses physics while the console is up */
+	player = EDICT_NUM (1);
+	now = sample_at (sv.time);
+	ahead = sample_at (sv.time + LOOKAHEAD);
+	VectorCopy (now->ang, cl.viewangles);
+
+	VectorSubtract (ahead->org, player->v.origin, vel);
+	VectorScale (vel, 1.0f / LOOKAHEAD, vel);
+	len = sqrt (vel[0] * vel[0] + vel[1] * vel[1]);
+	if (len > 400)
+		VectorScale (vel, 400 / len, vel);
+	yaw = now->ang[YAW] * M_PI / 180;
+	cmd->forwardmove = vel[0] * cos (yaw) + vel[1] * sin (yaw);
+	cmd->sidemove = vel[0] * sin (yaw) - vel[1] * cos (yaw);
+	cmd->upmove = player->v.waterlevel >= 2 ? CLAMP (-400, vel[2], 400) : 0;
+
+	in_attack.state = now->wframe ? 1 : 0;
+	in_jump.state = ((int) player->v.flags & FL_ONGROUND) && !ahead->onground && ahead->org[2] > player->v.origin[2] + 4 ? 1 : 0;
+	if (now->weapon && cl.stats[STAT_ACTIVEWEAPON] != now->weapon && sv.time - last_impulse > 0.5)
+	{
+		if (last_impulse > 0 && asked_weapon == now->weapon)
+		{	/* the last switch to it did not take: the bot does not own it */
+			impulse_failures++;
+			if (trace_on) { put8 ('P'); put8 (3); }
+		}
+		in_impulse = weapon_impulse (now->weapon);
+		asked_weapon = now->weapon;
+		last_impulse = sv.time;
+	}
+}
+
+void trace_shutdown (void)
+{
+	FILE *f;
+	unsigned long ours = 0, theirs = 0;
+	int i, j, differ = 0;
+
+	if (bin)
+	{
+		fclose (bin);
+		bin = NULL;
+	}
+	if (dump)
+	{
+		fclose (dump);
+		dump = NULL;
+	}
+	if (!trace_on || !(f = fopen (txtname, "w")))
+		return;
+	fprintf (f, "ticks %u teleports %u refills %u deaths %u weapon-not-owned %u\n", ticks, teleports, refills, deaths, impulse_failures);
+	fprintf (f, "woken %u of %u monsters\n", woken_n, monsters_n);
+	if (path)
+		fprintf (f, "path first sample %.3f, first server tick with a player %.3f\n", path[0].time, path_tick0);
+	for (i = 0; i < 256; i++)
+		if (op_hist[i])
+			fprintf (f, "op %d %u\n", i, op_hist[i]);
+	if (progs && progs_loads && pr_functions == fn_base)
+	{
+		for (i = 1; i < progs->numfunctions && i < MAX_TRACE_FUNCS; i++)
+		{
+			ours += fn_stmts[i];
+			theirs += pr_functions[i].profile;
+			if (fn_stmts[i] != (unsigned) pr_functions[i].profile)
+				differ++;
+			if (fn_stmts[i])
+				fprintf (f, "fn %d %s %u %d\n", i, PR_GetString (pr_functions[i].s_name),
+					 fn_stmts[i], pr_functions[i].profile);
+		}
+		fprintf (f, "profile check: traced %lu, engine profile %lu, functions differing %d\n", ours, theirs, differ);
+	}
+	else
+		fprintf (f, "profile check skipped: %u progs loads seen\n", progs_loads);
+	for (i = 0; i < num_classes; i++)
+		fprintf (f, "class %d %s\n", i, class_name[i]);
+	for (i = 0; i < num_classes; i++)
+		for (j = 0; j < MAX_TRACE_FIELDS; j++)
+			if (field_rw[i][j][0] || field_rw[i][j][1])
+				fprintf (f, "field %d %d %u %u\n", i, j, field_rw[i][j][0], field_rw[i][j][1]);
+	fclose (f);
+}
